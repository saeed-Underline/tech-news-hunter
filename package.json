{
  "name": "tech-news-hunter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Solo Leveling inspired daily tech news aggregator powered by GitHub Actions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
