    "pipeline": "node scripts/collect.mjs && node scripts/retention.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-xml-parser": "^4.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
